# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_read_only_user
SNOWFLAKE_ROLE=your_read_only_role
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.ssh/snowflake_reader.p8
# Only if your private key has a passphrase:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
